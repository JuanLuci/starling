/// The contract between Starling and its mods: Horizon's mod API (`horizon:mods`, whose 0.1 mods
/// Starling runs too) grown with what Starling adds, its own package so it never collides with
/// Horizon's next versions. A mod for it says `api = "starling-0.1"` in its manifest.
///
/// A mod is a WebAssembly component targeting the `starling-mod` world: any language that builds
/// components works (Rust with this SDK, C/C++, Go, JavaScript, Python, C#...). Each imported
/// interface but `log` and `types` is a capability: the mod's manifest lists the ones it uses,
/// the player sees them before turning the mod on, and the game refuses a component that
/// imports one its manifest does not declare.
///
/// Hooks are named after Fabric's events where one exists (in the comments), so a Fabric
/// client mod's callbacks map onto them one for one.
///
package starling:mods@0.1.0;

/// Shared types. Always granted.
interface types {
    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }
    enum direction {
        down,
        up,
        north,
        south,
        west,
        east,
    }
    enum hand {
        main-hand,
        off-hand,
    }
    enum game-mode {
        survival,
        creative,
        adventure,
        spectator,
    }
    /// An item stack as the game shows it.
    record item-stack {
        /// `minecraft:diamond_sword`.
        id: string,
        count: u32,
        damage: u32,
        /// 0 when the item has no durability.
        max-damage: u32,
        /// The name the player sees (a custom name, else the item's), as plain text.
        name: string,
        /// The components that differ from the item's defaults in their saved form, as `/give`
        /// writes them (`{"minecraft:custom_name":"Blade"}` in SNBT); empty when none.
        components: string,
    }
    /// Text shown to the player: plain text (legacy `§` codes work), or a JSON text component
    /// when it starts with `{` or `[` (`{"text":"Hi","color":"gold"}`).
    type rich-text = string;
}

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player, the clock, what the crosshair is on, the screen.
interface game {
    use types.{block-pos, direction, game-mode};

    record player {
        x: f64,
        y: f64,
        z: f64,
        /// Blocks per tick.
        velocity-x: f64,
        velocity-y: f64,
        velocity-z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        pitch: f32,
        health: f32,
        max-health: f32,
        absorption: f32,
        /// 0 to 20.
        food: u32,
        saturation: f32,
        /// Known in single player only (servers do not send it): 0 elsewhere.
        exhaustion: f32,
        /// Ticks of breath left, up to `max-air`.
        air: s32,
        max-air: s32,
        armor: u32,
        experience-level: u32,
        /// 0 to 1 along the experience bar.
        experience-progress: f32,
        /// 0 to 8.
        selected-slot: u32,
        game-mode: game-mode,
        on-ground: bool,
        sneaking: bool,
        sprinting: bool,
        swimming: bool,
        flying: bool,
        gliding: bool,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
        name: string,
        /// `069a79f4-44e9-4726-a5be-fca90e38aaf5`.
        uuid: string,
    }
    record effect {
        /// `minecraft:speed`.
        id: string,
        /// 0 for level I.
        amplifier: u32,
        /// Ticks left; -1 for an infinite effect.
        duration: s32,
        ambient: bool,
        visible: bool,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    record world-info {
        /// On a server (not single player).
        multiplayer: bool,
        /// The server's address, when on one.
        server: option<string>,
        /// 0 peaceful to 3 hard.
        difficulty: u32,
        hardcore: bool,
        raining: bool,
        thundering: bool,
    }
    record block-hit {
        pos: block-pos,
        face: direction,
        /// `minecraft:oak_log[axis=y]`.
        block: string,
    }
    record entity-hit {
        id: s32,
        /// `minecraft:zombie`.
        kind: string,
        x: f64,
        y: f64,
        z: f64,
    }
    /// What the crosshair is on (Minecraft.hitResult).
    variant target {
        miss,
        block(block-hit),
        entity(entity-hit),
    }
    /// The GUI's size in GUI pixels (what screens and the HUD draw in) and its scale.
    record gui {
        width: u32,
        height: u32,
        scale: f32,
    }
    /// The block the player is breaking.
    record mining {
        pos: block-pos,
        /// 0 to 1, as its cracks show.
        progress: f32,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    get-effects: func() -> list<effect>;
    get-clock: func() -> option<clock>;
    get-world-info: func() -> option<world-info>;
    get-target: func() -> target;
    /// The screen open now (see `events.screen-opened`), None while playing.
    get-screen: func() -> option<string>;
    get-gui: func() -> gui;
    /// Frames per second, as F3 shows it.
    get-fps: func() -> u32;
    /// None while the player is not breaking a block.
    get-mining: func() -> option<mining>;
}

/// Capability `world-read`: blocks and entities around the player.
interface level {
    use types.{block-pos};

    record entity {
        id: s32,
        /// `minecraft:zombie`.
        kind: string,
        x: f64,
        y: f64,
        z: f64,
        yaw: f32,
        /// For living entities.
        health: option<f32>,
        /// A custom name or a player's name.
        name: option<string>,
    }
    /// What the game shows of a block.
    record block-info {
        /// `minecraft:wheat[age=3]`.
        block: string,
        /// Its name in the player's language (`Wheat Crops`).
        name: string,
        /// The item picking it gives (`minecraft:wheat_seeds`); None for blocks with none
        /// (fire, water).
        item: option<string>,
        /// How long it takes to break (dirt 0.5, stone 1.5, obsidian 50); -1 for unbreakable.
        hardness: f32,
        /// The tool that breaks it fastest: `pickaxe`, `axe`, `shovel` or `hoe`.
        tool: option<string>,
        /// It drops something only when broken with the right tool (stone, ores).
        needs-tool: bool,
        /// Breaking it with what the player holds now would make it drop.
        harvestable: bool,
    }
    /// What the game shows of an entity.
    record entity-info {
        id: s32,
        /// `minecraft:zombie`.
        kind: string,
        /// Its name in the player's language: a custom name, else its kind's (`Zombie`).
        name: string,
        /// For living entities.
        health: option<f32>,
        max-health: option<f32>,
        /// Armor points, as the armor bar counts them.
        armor: f32,
        baby: bool,
    }
    /// `minecraft:oak_log[axis=y]`; None outside the loaded area within 24 blocks of the
    /// player.
    get-block: func(pos: block-pos) -> option<string>;
    /// None where `get-block` is None.
    get-block-info: func(pos: block-pos) -> option<block-info>;
    /// An entity `get-entities` lists (or `game.get-target` hits), by its id.
    get-entity-info: func(id: s32) -> option<entity-info>;
    /// `minecraft:plains`.
    get-biome: func(pos: block-pos) -> option<string>;
    /// Block light and sky light, 0 to 15.
    get-light: func(pos: block-pos) -> option<tuple<u8, u8>>;
    /// Entities within `radius` blocks of the player (at most 128, nearest first).
    get-entities: func(radius: f32) -> list<entity>;
}

/// Capability `inventory-read`: the player's items and the open container.
interface inventory {
    use types.{item-stack, hand};

    record food {
        nutrition: u32,
        saturation: f32,
        can-always-eat: bool,
    }
    record item-info {
        /// `minecraft:apple`.
        id: string,
        /// The item's name, as plain text.
        name: string,
        max-stack-size: u32,
        max-damage: u32,
        /// For food.
        food: option<food>,
    }
    record container {
        /// The menu type: `minecraft:generic_9x3`, `minecraft:furnace`, ...
        kind: string,
        /// The title the server gave it, as plain text.
        title: string,
        /// The container's own slots (not the player's inventory below them).
        slots: list<option<item-stack>>,
    }
    /// 0 to 8 the hotbar, 9 to 35 the rest, 36 to 39 the armour (feet to head), 40 the offhand.
    get-slot: func(slot: u32) -> option<item-stack>;
    get-held: func(hand: hand) -> option<item-stack>;
    /// The stack carried by the cursor in a screen.
    get-cursor: func() -> option<item-stack>;
    /// The stack under the cursor in a screen.
    get-hovered: func() -> option<item-stack>;
    get-container: func() -> option<container>;
    /// What an item is by default; None for an unknown id.
    get-item-info: func(id: string) -> option<item-info>;
    /// Where a stack comes in the game's own order of items: its place in the creative
    /// inventory's search tab (the tabs' order, building blocks first; a stack whose components
    /// the tab lists, such as an enchanted book's, at its own place, else at its item's first),
    /// the order Inventory Profiles sorts by; none for an item the tabs do not list.
    get-item-order: func(stack: item-stack) -> option<u32>;
}

/// Capability `inventory-click`: the open menu's slots, and clicks in them as the player's mouse
/// makes them (Fabric's `ClientPlayerInteractionManager.clickSlot`): a server gets vanilla's
/// clicks, predicted here as vanilla predicts them. With no screen open the menu is the player's
/// inventory, as vanilla's clicks there need none (a mod swapping armour while flying).
interface slots {
    use types.{item-stack};

    /// `ClickType`: what a click does.
    enum click-kind {
        /// Button 0 (left) or 1 (right): pick up, put down, swap, take half.
        pickup,
        /// Shift-click: to the other part of the menu.
        quick-move,
        /// Button 0 to 8 swaps with that hotbar slot, 40 with the off hand.
        swap,
        /// Button 2 in creative: a full stack of the slot's item on the cursor.
        clone,
        /// Button 0 drops one of the slot's items, 1 the whole stack.
        throw,
        /// A double click (button 0): the same item from the other slots onto the cursor.
        pickup-all,
    }
    record menu {
        /// `minecraft:inventory` (the player's own, no screen open too), `minecraft:crafting`,
        /// `minecraft:generic_9x3`, `minecraft:furnace`, `minecraft:merchant`...
        kind: string,
        /// Every slot by its id in vanilla's menu, the ids `click` takes. The player's
        /// inventory menu: 0 the crafting result, 1 to 4 its grid, 5 to 8 the armour from head
        /// to feet, 9 to 35 the inventory, 36 to 44 the hotbar, 45 the off hand. A container's
        /// menu: the container's slots, then the inventory's 27 and the hotbar's 9.
        slots: list<option<item-stack>>,
        /// The stack on the cursor.
        carried: option<item-stack>,
    }
    /// The open menu as this tick began, or as the mod's last clicks left it; none on a screen
    /// without slots (the pause menu).
    get-menu: func() -> option<menu>;
    /// A click on menu slot `slot` (-999 outside the window: a throw), done in order once the
    /// hook returns; `get-menu` shows its result from the next hook. Errs past 64 clicks in one
    /// call, or on a slot no menu has. On a mod's screen standing in for the creative screen
    /// (`screens.replace`) the menu is the player's inventory and the clicks are the creative
    /// screen's: done here, each slot they change sent to a server as it sends them.
    click: func(slot: s32, button: u8, kind: click-kind) -> result<_, string>;
    /// The stack on the cursor dragged across menu slots `slots` with button `button` held, as
    /// the mouse drags it (`ClickType.QUICK_CRAFT`): 0 shares it out evenly, 1 puts one in each,
    /// 2 (in creative) a full stack in each. The slots that cannot take it are left out and the
    /// rest stays on the cursor, as vanilla's drag leaves them. Done in order with the clicks, as
    /// clicks of their own (its start, one a slot, its end: the slots and 2 of the 64 a call may
    /// make); errs as `click` does, or on a button past 2.
    drag: func(slots: list<s32>, button: u8) -> result<_, string>;
}

/// Capability `creative`: the creative inventory's tabs and items as the game's creative screen
/// (CreativeModeInventoryScreen) lists and searches them, and, in creative mode, taking them as
/// that screen does: onto the cursor or into a slot, sent to a server as vanilla's
/// `SetCreativeModeSlot`. With `screens.replace("creative", ...)` a mod's screen stands in for the
/// game's.
interface creative {
    use types.{item-stack};

    /// `CreativeModeTab.Type`.
    enum tab-kind {
        /// Items to take: Building Blocks, Combat, a content mod's tab...
        category,
        /// Every item, filtered by what is searched.
        search,
        /// The player's survival inventory: no items of its own.
        inventory,
    }
    record tab {
        /// `minecraft:building_blocks`, `minecraft:search`, `minecraft:inventory`.
        id: string,
        /// Its name, as the player reads it.
        title: string,
        /// The item its icon shows: `minecraft:bricks`.
        icon: string,
        kind: tab-kind,
        /// Where the game's screen puts it: the top row or the bottom one, and its column, 0 to 6
        /// (5 and 6 at the right).
        top: bool,
        column: u32,
        /// How many items it lists (the search tab: with nothing searched).
        size: u32,
    }
    record item-page {
        /// How many items the tab lists (the search tab: that match).
        total: u32,
        /// From the asked start on.
        items: list<item-stack>,
    }
    /// How a click takes one of a tab's items (`slots.click-kind`'s that act on the creative
    /// screen's grid).
    enum click-kind {
        /// Button 0 or 1.
        pickup,
        /// Shift-click: a full stack.
        quick-move,
        /// Button 0 to 8: a full stack into that hotbar slot.
        swap,
        /// Button 2: a full stack onto an empty cursor.
        clone,
        /// Button 0 drops one, 1 a full stack.
        throw,
    }
    /// The tabs the game's creative screen shows, in its order; none before the world's
    /// resources have loaded.
    get-tabs: func() -> list<tab>;
    /// Up to `count` (at most 256) of tab `tab`'s items from item `start` on, in the screen's
    /// order. The search tab lists those matching `search` as its search box does (a name or a
    /// line of the tooltip, `#tag`, `namespace:path`; everything for ""); the others ignore it.
    /// An unknown tab lists nothing.
    get-items: func(tab: string, search: string, start: u32, count: u32) -> item-page;
    /// A click on item `index` of what `get-items(tab, search, ...)` lists, as on the creative
    /// screen's grid (`CreativeModeInventoryScreen.slotClicked` on a tab's slot): with nothing
    /// carried `pickup` takes it onto the cursor as listed and `quick-move` a full stack; with the
    /// same item carried button 0 adds one (`quick-move`: fills the stack) and button 1 takes one
    /// away; any other item carried is destroyed by button 0, one of it by button 1. `clone`,
    /// `swap` and `throw` as their comments say. Creative mode only; done in order with the
    /// mod's `slots.click`s once the hook returns.
    click: func(tab: string, search: string, index: u32, button: u8, kind: click-kind) -> result<_, string>;
    /// Puts `stack` (none empties it) in slot `slot` of the player's inventory menu, by `slots`'
    /// ids: 1 to 4 the crafting grid, 5 to 8 the armour (head first), 9 to 35 the inventory, 36 to
    /// 44 the hotbar, 45 the off hand (`MultiPlayerGameMode.handleCreativeModeItemAdd`). Errs on
    /// another slot, on more than the item stacks to, and outside creative mode.
    set-slot: func(slot: u32, stack: option<item-stack>) -> result<_, string>;
    /// Puts `stack` on the cursor in place of what it carried; none destroys that (the creative
    /// screen's Destroy Item slot). Errs on more than the item stacks to, and outside creative
    /// mode.
    set-carried: func(stack: option<item-stack>) -> result<_, string>;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    use types.{rich-text};
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: rich-text);
    /// Shown above the hotbar (the action bar).
    show-overlay: func(text: rich-text);
}

/// Capability `chat-send`: messages and commands sent as the player (to the server, or to the
/// game in single player). At most 4 per second.
interface chat-send {
    /// A chat line, or a `/command`.
    send: func(message: string) -> result<_, string>;
}

/// Capability `hud`: drawing on the screen. Calls draw only inside `events.hud-render`,
/// `events.hud-element` and `events.screen-render`; elsewhere they do nothing. Coordinates are
/// GUI pixels (`game.get-gui`), colours 0xAARRGGBB (alpha 0 is opaque, as a convenience:
/// 0xRRGGBB draws solid).
interface draw {
    use types.{item-stack, rich-text};

    fill: func(x: f32, y: f32, width: f32, height: f32, color: u32);
    /// Top colour to bottom colour.
    gradient: func(x: f32, y: f32, width: f32, height: f32, top: u32, bottom: u32);
    /// Draws `text`, returns its width.
    text: func(x: f32, y: f32, text: rich-text, color: u32, shadow: bool) -> f32;
    text-width: func(text: rich-text) -> f32;
    /// An item's icon (16x16), with its count and durability bar as in an inventory.
    item: func(x: f32, y: f32, stack: item-stack);
    /// An item's icon by id.
    item-id: func(x: f32, y: f32, id: string);
    /// A GUI sprite from the resource packs' atlas (`hud/food_full`, `container/slot`, a
    /// content mod's own `<id>:my_icon` from `assets/<id>/textures/gui/sprites/`), stretched to
    /// the size.
    sprite: func(x: f32, y: f32, width: f32, height: f32, sprite: string);
    /// The vanilla tooltip box with these lines at the point.
    tooltip: func(x: f32, y: f32, lines: list<rich-text>);
    /// A vanilla button.
    button: func(x: f32, y: f32, width: f32, height: f32, label: rich-text, hovered: bool, active: bool);
    /// A vanilla window background (the menus' panel).
    panel: func(x: f32, y: f32, width: f32, height: f32);
    /// Moves and scales what is drawn after it, until `pop`.
    push: func(x: f32, y: f32, scale: f32);
    pop: func();
    /// The player as the inventory shows them (`InventoryScreen.renderEntityInInventoryFollowsMouse`):
    /// standing in the box, `size` GUI pixels a block (the inventory's is 30, the creative
    /// screen's 20), the head toward the mouse (ahead on a touch screen), turned `turn` degrees
    /// more.
    player: func(x: f32, y: f32, width: f32, height: f32, size: f32, turn: f32);
    /// A stack's tooltip as the game shows it over a slot (`Screen.getTooltipFromItem`: its
    /// name, lore, enchantments, attributes, the mods' lines), placed from the point as `tooltip`.
    item-tooltip: func(x: f32, y: f32, stack: item-stack);
}

/// Capability `hud`: the mod's retained text panel (API 0.1), drawn every frame until changed.
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    set-panel: func(corner: corner, lines: list<line>);
    clear: func();
}

/// Capability `ui`: the mod's own screens. A screen opened here is drawn and fed input
/// through `events.screen-render`, `screen-mouse` and `screen-key` as `<mod id>:<name>`; Escape
/// closes it.
interface screens {
    /// Opens `<mod id>:<name>` over whatever is shown.
    open: func(name: string);
    /// Closes the mod's screen if one is open.
    close: func();
    /// The mod's settings screen, `<mod id>:<name>` (Mod Menu's config screen): a Config button
    /// beside the mod on the Mods page opens it, over the page. Called in `init`; the mod draws
    /// it as any of its screens (`registration.screens`).
    set-config: func(name: string);
    /// From now on the mod's screen `<mod id>:<name>` opens wherever the game would open its own
    /// `screen`, and the game's opens again for "": `creative` (the creative inventory) is the one
    /// that can be. The screen open now changes over too. False for a screen that cannot be
    /// replaced or a bad name. Standing in for the creative screen, the mod's screen is closed by
    /// the inventory key when `screen-key` does not use it, its `slots` clicks are the creative
    /// screen's, and closing it destroys what the cursor carries, as the creative screen's does.
    replace: func(screen: string, name: string) -> bool;
}

/// Capability `ui`: buttons the mod puts on the game's own screens and on the touch controls. A
/// button is pressed as a keybind of the mod is: `events.key(id, true)`, then `events.key(id,
/// false)` when let go (a click on a screen sends both), `keys.is-down(id)` true meanwhile.
/// Adding a button with an id the mod already gave one replaces that one (a new label, say).
interface widgets {
    use types.{rich-text};

    /// The point of the screen, and the same point of the button, that a button's offset is
    /// from (Bedrock's `anchor_from` and `anchor_to`): `top-right` with x -4 and y 4 puts the
    /// button's top right corner 4 pixels left of and 4 below the screen's.
    enum anchor {
        top-left,
        top-middle,
        top-right,
        left-middle,
        center,
        right-middle,
        bottom-left,
        bottom-middle,
        bottom-right,
    }
    /// Fabric's `Screens.getButtons(screen).add(ButtonWidget.builder(...).build())`, NeoForge's
    /// `ScreenEvent.Init.Post.addListener`: a button drawn as the screen's own are.
    record screen-button {
        id: string,
        /// Which screen, by the names `events.screen-opened` gives: `pause`, `title`,
        /// `inventory`, `creative`, `container`, `options`, `worlds`, `multiplayer`, `death`...
        screen: string,
        anchor: anchor,
        /// Its offset from the anchor and its size, in GUI pixels (vanilla's buttons are 20
        /// tall).
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        label: rich-text,
        /// A GUI sprite drawn before the label, as tall as the button lets it be ("" for none):
        /// `icon/accessibility`, `item/compass`, a content mod's `<id>:my_icon`.
        icon: string,
        /// Shown while the mouse is over it.
        tooltip: list<rich-text>,
        /// Greyed and not pressed when false.
        active: bool,
    }
    enum shape {
        /// A circle, as the game's own touch buttons.
        round,
        /// A rounded square, as Bedrock's.
        square,
        /// As wide as its label: a keybind's button.
        wide,
    }
    /// One of Bedrock's touch buttons: on the touch controls while playing on a touch screen,
    /// moved, resized, faded and hidden by the player in the touch layout editor as the game's
    /// own buttons are. Each keybind of the mod has one already, wide and labelled with its name;
    /// one with a keybind's id gives that one its look and place.
    record touch-button {
        id: string,
        /// Shown on it when it has no icon, and in the editor. Short: "Zoom", "Map".
        label: string,
        /// A GUI sprite drawn on it instead of the label ("" for none): `item/spyglass`,
        /// `hud/heart/full`, a content mod's `<id>:my_icon`.
        icon: string,
        shape: shape,
        /// Where it is until the player moves it: its centre as a share of the screen's width
        /// and height (0 to 1), and its size in the controls' units (a ninth of the screen's
        /// shorter side across its middle; the game's Jump is 0.8, Pause 0.45).
        x: f32,
        y: f32,
        size: f32,
    }
    /// The part of a slotted screen's window a `window-button` is placed from.
    enum window-part {
        /// The slots of what was opened: a chest's, a barrel's, a furnace's...
        container,
        /// The player's inventory and hotbar: on the inventory, under a container's slots, on
        /// the creative screen's inventory tab.
        inventory,
    }
    /// Quark's and Inventory Profiles' chest buttons: a small button on the window of a screen
    /// with slots, placed from the box around one part's slots (each slot's 18-pixel cell) as the
    /// game lays that part out on the screen open, so it sits right on a chest of any size, a
    /// barrel, a hopper, the inventory and the creative screen's inventory tab alike. Shown while
    /// the screen shows the part (the creative screen's item tabs show no inventory) and the menu
    /// is one of `menus`; pressed as a screen button is.
    record window-button {
        id: string,
        part: window-part,
        /// The point of the part's box, and the same point of the button, its offset is from:
        /// `top-right` with x -1 and y -12 puts a 10-pixel button right-aligned in the title row
        /// above the slots.
        anchor: anchor,
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        /// A GUI sprite drawn as the whole button, its frame too, and the one with
        /// `_highlighted` after its name under the mouse or a finger when the atlas has it. A
        /// mod's own sprites (`assets/<id>/textures/gui/sprites/`) load as the game starts.
        icon: string,
        /// Drawn on a plain button instead while the icon is not in the atlas: a letter or two.
        label: rich-text,
        tooltip: list<rich-text>,
        /// The open menus it shows on, by `slots.get-menu`'s kind (`minecraft:generic_9x3`,
        /// `minecraft:inventory`...); empty: every menu with the part.
        menus: list<string>,
    }
    add-screen-button: func(button: screen-button) -> result<_, string>;
    add-touch-button: func(button: touch-button) -> result<_, string>;
    add-window-button: func(button: window-button) -> result<_, string>;
    /// Takes away the mod's button with this id, of any kind.
    remove: func(id: string);
    /// Restyles one of the game's own touch buttons, as Bedrock's resource packs retexture
    /// theirs: `jump`, `sneak`, `attack`, `use`, `inventory`, `chat`, `command`, `pause`,
    /// `camera`, `drop` or `offhand`. `label` and `icon` as a touch button's ("" keeps the
    /// game's); `wide` draws it round. False for another name. A resource pack can do this too,
    /// with `assets/starling/textures/gui/sprites/touch/<name>.png` (and `<name>_pressed.png`),
    /// drawn over the whole button; a mod's style wins over a pack's.
    style-control: func(control: string, label: string, icon: string, shape: shape) -> bool;
}

/// The device: always granted, on every device (where a part does not apply it does nothing).
interface mobile {
    /// Whether the player plays with a touch screen (the phone), so a mod can lay its screens
    /// out for fingers.
    has-touch: func() -> bool;
    /// Shows (or hides) the on-screen keyboard over the mod's open screen, for a text field it
    /// draws: on a phone there is no keyboard otherwise. Its keys come to `screen-key` with
    /// their text. Closing the screen hides it. Without a touch screen it does nothing.
    keyboard: func(shown: bool);
    /// Where on the mod's open screen a finger drags whichever way it moves (pressed, then a
    /// `drag` for each move, as the mouse held) instead of scrolling when it moves up or down:
    /// a scrollbar that follows the finger, slots a stack is spread across. Boxes as (x, y,
    /// width, height) in the screen's GUI pixels, kept until the next call or until the screen
    /// closes; at most 64. Without a touch screen it does nothing.
    drag-areas: func(areas: list<tuple<f32, f32, f32, f32>>);
}

/// Capability `keys`: whether the mod's keybinds (from its registration) are held.
interface keys {
    /// One of the mod's own keybinds (`registration.keybinds`), by its id.
    is-down: func(id: string) -> bool;
    /// One of the game's controls as the player holds it now, by keyboard, mouse, controller or
    /// touch: `key.forward`, `key.back`, `key.left`, `key.right`, `key.jump`, `key.sneak`,
    /// `key.sprint`, `key.attack` or `key.use`. False behind a screen.
    is-control-down: func(control: string) -> bool;
    /// How many times one of those controls has been pressed since the game started (clicks per
    /// second: how much it grew over the last second).
    presses: func(control: string) -> u64;
}

/// Capability `input`: hold the game's sprint and sneak controls for the player, as its Toggle
/// Sprint and Toggle Sneak options do.
interface input {
    /// Holds `key.sprint` or `key.sneak` (`held`) until let go; the player's own keys still work.
    /// False for any other control.
    hold: func(control: string, held: bool) -> bool;
}

/// Capability `sound`: sounds only the player hears.
interface sound {
    /// `minecraft:entity.experience_orb.pickup`, or a content mod's own sound event.
    play: func(id: string, volume: f32, pitch: f32);
}

/// Capability `net`: custom payloads on the mod's channels (from its registration), to and
/// from a server's plugins or mods (Fabric's ClientPlayNetworking).
interface net {
    /// Errs when not on a server, or the channel is not the mod's. At most 32 KiB.
    send: func(channel: string, data: list<u8>) -> result<_, string>;
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd (docs/mods.md).
/// Keys are `[a-z0-9_.-]{1,64}`, one path segment.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    use types.{block-pos, direction, hand, item-stack, rich-text};

    /// A part of the vanilla HUD, which a mod's element is drawn before, after or instead of.
    enum hud-part {
        crosshair,
        hotbar,
        /// Hearts.
        health,
        armor,
        food,
        air,
        mount-health,
        experience,
        effects,
        boss-bars,
        selected-item-name,
        scoreboard,
        chat,
    }
    enum placement {
        before,
        after,
        /// The vanilla part is not drawn.
        replace,
    }
    /// HudElementRegistry.attachElementBefore / After / replaceElement.
    record hud-element {
        id: string,
        part: hud-part,
        placement: placement,
    }
    /// KeyBindingHelper.registerKeyBinding.
    record keybind {
        id: string,
        /// Shown to the player.
        name: string,
        /// The default key: `key.keyboard.r`, `key.keyboard.left.shift`, `key.mouse.middle`.
        key: string,
    }
    record registration {
        /// Chat commands, without the slash (ClientCommandRegistrationCallback). A name the
        /// game or the server already uses is not taken (theirs runs).
        commands: list<string>,
        /// `tick` every game tick, 20 per second (ClientTickEvents.END_CLIENT_TICK).
        tick: bool,
        /// `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// `chat-received` for each chat line (ClientReceiveMessageEvents).
        chat: bool,
        /// `chat-sending` for each line the player sends (ClientSendMessageEvents).
        chat-send: bool,
        /// `hud-render` every frame, over the HUD (HudRenderCallback).
        hud: bool,
        hud-elements: list<hud-element>,
        /// The game's screens: `screen-opened`, `screen-closed`, `screen-render`, `screen-mouse`
        /// and `screen-key` (ScreenEvents). A mod's own screens get these whatever this says.
        screens: bool,
        /// `tooltip` for each item tooltip shown (ItemTooltipCallback).
        tooltips: bool,
        keybinds: list<keybind>,
        /// Payload channels (`namespace:path`) the mod sends and receives on.
        channels: list<string>,
        /// `joined`, `left` and `dimension-changed` (ClientPlayConnectionEvents).
        connection: bool,
        /// `use-item`, `use-block`, `attack-entity`, `attack-block` and `block-broken`
        /// (UseItemCallback, UseBlockCallback, AttackEntityCallback, AttackBlockCallback,
        /// ClientPlayerBlockBreakEvents).
        interaction: bool,
        /// `player-hurt`.
        damage: bool,
    }
    /// The GUI's size and the mouse, in GUI pixels.
    record render-context {
        width: u32,
        height: u32,
        mouse-x: f32,
        mouse-y: f32,
        /// Seconds since the last frame.
        delta: f32,
    }
    enum mouse-action {
        press,
        release,
        drag,
        scroll,
    }
    record mouse-event {
        action: mouse-action,
        x: f32,
        y: f32,
        /// 0 left, 1 right, 2 middle (a tap on a touch screen is a left click).
        button: u8,
        /// Scroll lines, up positive.
        scroll: f32,
    }
    record key-event {
        /// `key.keyboard.e`, `key.keyboard.escape`, ...
        key: string,
        pressed: bool,
        /// The text the key typed, if any.
        text: string,
        shift: bool,
        control: bool,
        alt: bool,
    }
    variant chat-action {
        keep,
        hide,
        replace(rich-text),
    }
    variant send-action {
        send,
        cancel,
        replace(string),
    }

    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    tick: func(tick: u64);
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    /// A chat line the player receives, as plain text and as a JSON text component.
    chat-received: func(plain: string, component: rich-text) -> chat-action;
    /// A chat line or `/command` the player is about to send.
    chat-sending: func(message: string) -> send-action;
    hud-render: func(context: render-context);
    render-hud-element: func(id: string, context: render-context);
    /// `inventory`, `creative`, `container` (any container menu: `inventory.get-container`),
    /// `pause`, `options`, `chat`, `death`, `sign`, `book`, `advancements`, `title`,
    /// `multiplayer`, `worlds`, a mod's own `<id>:<name>`...
    screen-opened: func(screen: string);
    screen-closed: func(screen: string);
    /// After the screen drew (a mod's own screen draws everything here).
    screen-render: func(screen: string, context: render-context);
    /// True when the mod used the event: the screen does not get it.
    screen-mouse: func(screen: string, event: mouse-event) -> bool;
    screen-key: func(screen: string, event: key-event) -> bool;
    /// Lines added under an item's tooltip.
    tooltip: func(stack: item-stack) -> list<rich-text>;
    /// A keybind of the mod's pressed or released.
    key: func(id: string, pressed: bool);
    /// A payload on one of the mod's channels.
    payload: func(channel: string, data: list<u8>);
    /// The player entered a world: single player (None) or a server's address.
    joined: func(server: option<string>);
    left: func();
    dimension-changed: func(dimension: string);
    /// False cancels the action.
    use-item: func(hand: hand) -> bool;
    use-block: func(pos: block-pos, face: direction, hand: hand) -> bool;
    attack-entity: func(entity: s32) -> bool;
    attack-block: func(pos: block-pos, face: direction) -> bool;
    /// The player broke a block (seen by the client).
    block-broken: func(pos: block-pos, block: string);
    /// The player lost health.
    player-hurt: func(amount: f32);
}

world starling-mod {
    import types;
    import mobile;
    import log;
    import game;
    import level;
    import inventory;
    import slots;
    import creative;
    import chat;
    import chat-send;
    import draw;
    import hud;
    import screens;
    import widgets;
    import keys;
    import input;
    import sound;
    import net;
    import storage;
    export events;
}

/// Starling's shared JavaScript engine's own import, not a mod's: the JavaScript mod's source,
/// which the engine runs. The game refuses a mod component importing it.
interface js-source {
    get: func() -> string;
    /// A number that changes whenever what mods read of the game does (once a tick, and before a
    /// command or a press): the engine keeps the game's answers until it changes.
    snapshot: func() -> u32;
}

/// The JavaScript engine's own import too: `draw.fill` and `draw.gradient` with their ARGB
/// colours as s32 (the same bits), which the engine calls instead, since componentize-js passes
/// a u32 of 2^31 or more (an alpha of 0x80 or more) wrong. Linked with `draw`.
interface js-draw {
    fill: func(x: f32, y: f32, width: f32, height: f32, color: s32);
    gradient: func(x: f32, y: f32, width: f32, height: f32, top: s32, bottom: s32);
    /// A render hook's drawing in one call (a call from the engine costs microseconds): 32-bit
    /// little-endian slots, each call an opcode and its arguments (f32, colours as their bits):
    /// 1 fill x y w h color, 2 gradient x y w h top bottom, 3 text x y color shadow text,
    /// 4 sprite x y w h name, 5 push x y scale, 6 pop; `text` and `name` index the `count`
    /// strings of `texts`, UTF-8 joined by NUL (bytes pass whole, a string by the character):
    /// when it splits into another count (a text holding a NUL), the batch's texts and sprites
    /// are left out.
    batch: func(ops: list<u8>, count: u32, texts: list<u8>);
}

/// The JavaScript engine's own import too, linked with `keys`: the game's controls held now, one
/// bit each in `keys.is-control-down`'s order (`key.forward` the lowest), which the engine reads
/// once a hook instead of a call a control.
interface js-keys {
    held: func() -> u32;
}

/// Starling's shared JavaScript engine (js-engine/): one component every JavaScript mod runs in,
/// its source given by `js-source`. A JavaScript mod ships `mod.js` (an ES module importing these
/// interfaces and exporting `events`) instead of a component.
world starling-js {
    include starling-mod;
    import js-source;
    import js-draw;
    import js-keys;
}
